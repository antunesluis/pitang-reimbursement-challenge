    {
      "name": "4. Reimbursements — Full Cycle",
      "description": "1. Employee creates → 2. Submits → 3. Manager approves → 4. Finance pays",
      "item": [
        {
          "name": "1. Create (Employee → DRAFT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('Status is DRAFT', () => pm.expect(r.status).to.equal('DRAFT'));",
                  "if (r.id) pm.collectionVariables.set('reimbursementId', r.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"description\":\"Almoço com cliente\",\"amount\":85.50,\"expenseDate\":\"2026-04-25\",\"categoryId\":\"{{categoryId}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{url}}/reimbursements",
              "host": ["{{url}}"],
              "path": ["reimbursements"]
            }
          }
        },
        {
          "name": "2. Submit (Employee → SUBMITTED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is SUBMITTED', () => pm.expect(pm.response.json().status).to.equal('SUBMITTED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }],
            "url": {
              "raw": "{{url}}/reimbursements/{{reimbursementId}}/submit",
              "host": ["{{url}}"],
              "path": ["reimbursements", "{{reimbursementId}}", "submit"]
            }
          }
        },
        {
          "name": "3. Approve (Manager → APPROVED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is APPROVED', () => pm.expect(pm.response.json().status).to.equal('APPROVED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": {
              "raw": "{{url}}/reimbursements/{{reimbursementId}}/approve",
              "host": ["{{url}}"],
              "path": ["reimbursements", "{{reimbursementId}}", "approve"]
            }
          }
        },
        {
          "name": "4. Pay (Finance → PAID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status is PAID', () => pm.expect(pm.response.json().status).to.equal('PAID'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{financeToken}}" }],
            "url": {
              "raw": "{{url}}/reimbursements/{{reimbursementId}}/pay",
              "host": ["{{url}}"],
              "path": ["reimbursements", "{{reimbursementId}}", "pay"]
            }
          }
        },
        {
          "name": "5. Get History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has history entries', () => pm.expect(pm.response.json()).to.be.an('array').with.lengthOf.at.least(4));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }],
            "url": {
              "raw": "{{url}}/reimbursements/{{reimbursementId}}/history",
              "host": ["{{url}}"],
              "path": ["reimbursements", "{{reimbursementId}}", "history"]
            }
          }
        }
      ]
    },
